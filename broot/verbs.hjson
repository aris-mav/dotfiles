# Documentation at https://dystroy.org/broot/verbs/

verbs: [
    {
        invocation: edit
        shortcut: e
        key: alt-e
        execution: "$EDITOR +{line} {file}"
        leave_broot: false
    }
    { key: "enter", execution: ":edit", apply_to: text_file }
    {
        invocation: sudoedit
        shortcut: se
        apply_to: text_file
        execution: "sudo $EDITOR +{line} {file}"
        leave_broot: false
    }
    {
        key: i
        internal: mode_input
    }
    {
        key: q
        internal: quit
    }
    {
        name: touch
        invocation: touch {new_file}
        execution: "touch {directory}/{new_file}"
        leave_broot: false
    }
    {
        invocation: create {subpath}
        execution: "$EDITOR {directory}/{subpath}"
        leave_broot: false
    }
    {
        invocation: git_diff
        shortcut: gd
        leave_broot: false
        execution: "git difftool -y {file}"
    }
    {
        invocation: yank
        shortcut: y
        leave_broot: false
        execution: "$YANKTEXT {file}"
    }
    {
        invocation: nautilus
        shortcut: na
        leave_broot: true
        execution: "nautilus {directory}"
    }
    {
        invocation: ripdrag
        shortcut: rd
        leave_broot: false
        execution: "ripdrag {file}"
        refresh_after: true
    }
    {
        invocation: "backup {version}"
        key: ctrl-b
        leave_broot: false
        auto_exec: false
        execution: "cp -r {file} {parent}/{file-stem}-{version}{file-dot-extension}"
    }
    {
        invocation: "rm"
        internal: "trash"
        leave_broot: false
    }
    {
        invocation: home
        key: home
        execution: ":focus ~"
    }

    { key: "ctrl-p"  , execution: ":line_up" }
    { key: "ctrl-n"  , execution: ":line_down" }
    { key: "ctrl-u"  , execution: ":page_up" }
    { key: "ctrl-d"  , execution: ":page_down" }
	{ key: "ctrl-w"  , internal: ":input_del_word_left" }

	{ key: "alt-h"   , internal: ":panel_left" }
	{ key: "alt-j"   , internal: ":root_down" }
	{ key: "alt-k"   , internal: ":root_up" }
	{ key: "alt-l"   , internal: ":panel_right" }

	{ key: "Tab"     , cmd: ":toggle_stage;:next_match" }
	{ key: "BackTab" , cmd: ":toggle_stage;:previous_match" }

]
