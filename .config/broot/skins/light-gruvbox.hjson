###############################################################
# Gruvbox Light skin for broot
# Based on official Gruvbox Light palette
###############################################################

skin: {
    default: rgb(60, 56, 54) none / rgb(235, 219, 178) none
    tree: rgb(124, 111, 100) None / rgb(251, 241, 199) None
    parent: rgb(60, 56, 54) none / rgb(235, 219, 178) none Italic
    file: None None / None None Italic
    directory: rgb(69, 133, 136) None Bold / rgb(211, 202, 169) None
    exe: rgb(152, 151, 26) None
    link: rgb(104, 157, 106) None
    pruning: rgb(146, 131, 116) None Italic

    perm__: None None
    perm_r: rgb(181, 118, 20) None
    perm_w: rgb(204, 36, 29) None
    perm_x: rgb(152, 151, 26) None
    owner: rgb(181, 118, 20) None Bold
    group: rgb(181, 118, 20) None

    count: rgb(69, 133, 136) rgb(235, 219, 178)
    dates: rgb(124, 111, 100) None
    sparse: rgb(215, 153, 33) None

    content_extract: ansi(29) None Italic
    content_match: ansi(34) None Bold

    git_branch: rgb(60, 56, 54) None
    git_insertions: rgb(152, 151, 26) None
    git_deletions: rgb(204, 36, 29) None
    git_status_current: rgb(124, 111, 100) None
    git_status_modified: rgb(152, 151, 26) None
    git_status_new: rgb(104, 157, 106) None Bold
    git_status_ignored: rgb(168, 153, 132) None
    git_status_conflicted: rgb(204, 36, 29) None
    git_status_other: rgb(204, 36, 29) None

    selected_line: None rgb(211, 202, 169) / None rgb(197, 189, 157)
    char_match: rgb(215, 153, 33) None
    file_error: rgb(251, 73, 52) None

    flag_label: rgb(124, 111, 100) None
    flag_value: rgb(177, 98, 134) None Bold

    input: rgb(60, 56, 54) None / rgb(211, 202, 169) None Italic

    status_error: rgb(235, 219, 178) rgb(204, 36, 29)
    status_job: rgb(215, 153, 33) rgb(211, 202, 169)
    status_normal: None rgb(235, 219, 178) / None None
    status_italic: rgb(177, 98, 134) rgb(235, 219, 178) Italic / None None
    status_bold: rgb(177, 98, 134) rgb(235, 219, 178) Bold / None None
    status_code: rgb(60, 56, 54) rgb(235, 219, 178) / None None
    status_ellipsis: rgb(60, 56, 54) rgb(235, 219, 178) Bold / None None

    purpose_normal: None None
    purpose_italic: rgb(177, 98, 134) None Italic
    purpose_bold: rgb(177, 98, 134) None Bold
    purpose_ellipsis: None None

    scrollbar_track: rgb(211, 202, 169) None / rgb(197, 189, 157) None
    scrollbar_thumb: rgb(124, 111, 100) None / rgb(168, 153, 132) None

    help_paragraph: None None
    help_bold: rgb(214, 93, 14) None Bold
    help_italic: rgb(177, 98, 134) None Italic
    help_code: rgb(104, 157, 106) rgb(235, 219, 178)
    help_headers: rgb(254, 128, 25) None Bold
    help_table_border: rgb(168, 153, 132) None

    preview_title: rgb(60, 56, 54) rgb(251, 241, 199) / rgb(124, 111, 100) rgb(251, 241, 199)
    preview: rgb(60, 56, 54) rgb(251, 241, 199) / rgb(60, 56, 54) rgb(251, 241, 199)
    preview_line_number: rgb(146, 131, 116) None / rgb(146, 131, 116) rgb(251, 241, 199)
    preview_separator: rgb(168, 153, 132) None / rgb(197, 189, 157) None
    preview_match: None ansi(29) Bold

    hex_null: rgb(124, 111, 100) None
    hex_ascii_graphic: rgb(60, 56, 54) None
    hex_ascii_whitespace: rgb(152, 151, 26) None
    hex_ascii_other: rgb(254, 128, 25) None
    hex_non_ascii: rgb(214, 93, 14) None

    staging_area_title: rgb(60, 56, 54) rgb(251, 241, 199) / rgb(124, 111, 100) rgb(251, 241, 199)

    mode_command_mark: gray(3) ansi(204) Bold

    good_to_bad_0: ansi(28)
    good_to_bad_1: ansi(29)
    good_to_bad_2: ansi(29)
    good_to_bad_3: ansi(29)
    good_to_bad_4: ansi(29)
    good_to_bad_5: ansi(100)
    good_to_bad_6: ansi(136)
    good_to_bad_7: ansi(172)
    good_to_bad_8: ansi(166)
    good_to_bad_9: ansi(196)
}
