(defsrc
 grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
 tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
 caps a    s    d    f    g    h    j    k    l    ;    '    ret
 lsft z    x    c    v    b    n    m    ,    .    /    rsft
 lctl      lmet lalt      spc            ralt rctl 
 )

(deflayer base
 grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
 tab  @q   @w   @e   @r   t    y    @u   @i   @o   @p   [    ]    \
 esc  @a   @s   @d   @f   g    h    @j   @k   @l   @;   '    ret
 lsft z    x    c    v    b    n    m    ,    .    /    rsft
 lctl      lmet lalt      @sp            ralt rctl 
 )

(deflayer nomods
 grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
 tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
 esc  a    s    d    f    g    h    j    k    l    ;    '    ret
 lsft z    x    c    v    b    n    m    ,    .    /    rsft
 lctl      lmet lalt      spc            ralt rctl 
 )

(deflayer spc_layer
 _    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11 f12   _
 _    _    mmid @mau mrgt @mwu  home pgdn pgup end  _    _    _   _
 _    mlft @mal @mad @mar @mwd  left down up   rght _    _    _
 _    caps del  @cw  S-tab bspc tab  ret  [    ]    \    _
 _         _    _         XX             _    _ 
 )


(defvar
 tap-time 200
 hold-time-long 150
 hold-time-mid 120
 hold-time-short 100

 left-hand-keys (
    1 2 3 4 5
    q w e r t
    a s d f g
    z x c v 
  )
  right-hand-keys (
    6 7 8 9 0
    y u i o p
    h j k l ;
    n m , . /
  )
 )

 (deffakekeys
  to-base (layer-switch base)
)

(defalias
  tap (multi
    (layer-switch nomods)
    (on-idle-fakekey to-base tap 20)
  )
)

(defalias

 sp (tap-hold-press $tap-time $hold-time-long spc (layer-while-held spc_layer))

 ;; Home row mods
 a (tap-hold-release-keys $tap-time $hold-time-long  (multi a @tap) rmet $left-hand-keys)
 s (tap-hold-release-keys $tap-time $hold-time-long  (multi s @tap) lalt $left-hand-keys)
 d (tap-hold-release-keys $tap-time $hold-time-short (multi d @tap) lsft $left-hand-keys)
 f (tap-hold-release-keys $tap-time $hold-time-mid   (multi f @tap) lctl $left-hand-keys)

 j (tap-hold-release-keys $tap-time $hold-time-mid   (multi j @tap) rctl $right-hand-keys)
 k (tap-hold-release-keys $tap-time $hold-time-short (multi k @tap) rsft $right-hand-keys)
 l (tap-hold-release-keys $tap-time $hold-time-long  (multi l @tap) lalt $right-hand-keys)
 ; (tap-hold-release-keys $tap-time $hold-time-long  (multi ; @tap) rmet $right-hand-keys)


 ;; Top row mods
 q (tap-hold-release-keys $tap-time $hold-time-long   (multi q @tap) (multi lmet lsft) $left-hand-keys)
 w (tap-hold-release-keys $tap-time $hold-time-long   (multi w @tap) (multi lalt lsft) $left-hand-keys)
 e (tap-hold-release-keys $tap-time $hold-time-long   (multi e @tap) (multi lalt lctrl) $left-hand-keys)
 r (tap-hold-release-keys $tap-time $hold-time-long   (multi r @tap) (multi lctl lsft) $left-hand-keys)

 u (tap-hold-release-keys $tap-time $hold-time-long   (multi u @tap) (multi rctl rsft) $right-hand-keys)
 i (tap-hold-release-keys $tap-time $hold-time-long   (multi i @tap) (multi lalt rctrl) $right-hand-keys)
 o (tap-hold-release-keys $tap-time $hold-time-long   (multi o @tap) (multi lalt rsft) $right-hand-keys)
 p (tap-hold-release-keys $tap-time $hold-time-long   (multi p @tap) (multi rmet rsft) $right-hand-keys)


 mwu (mwheel-up 50 60)
 mwd (mwheel-down 50 60)
 mwl (mwheel-left 50 60)
 mwr (mwheel-right 50 60)

 mau (movemouse-accel-up 3 300 1 5)
 mal (movemouse-accel-left 3 300 1 5)
 mad (movemouse-accel-down 3 300 1 5)
 mar (movemouse-accel-right 3 300 1 5)

 cw (caps-word 2000)

 )

(defcfg
 linux-dev-names-exclude (
     "DPB Ferris sweep Consumer Control"
     "DPB Ferris sweep System Control"
     "DPB Ferris sweep"
     "Keychron V4 Max Keyboard"
     )
 )
