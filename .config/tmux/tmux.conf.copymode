# enter copy mode
bind -n M-c copy-mode 
bind -n M-\; copy-mode 

# Exit copy mode with i
bind -T copy-mode-vi i send -X cancel

# Start selection with 'v' and copy with 'y'
bind -T copy-mode-vi v send -X begin-selection
bind -T copy-mode-vi y send -X copy-selection-and-cancel

# scroll up and down - keep cursor in centre
bind-key -T copy-mode-vi C-d send-keys -X halfpage-down \; send-keys -X middle-line
bind-key -T copy-mode-vi C-u send-keys -X halfpage-up \; send-keys -X middle-line
bind-key -T copy-mode-vi d send-keys -X halfpage-down \; send-keys -X middle-line
bind-key -T copy-mode-vi u send-keys -X halfpage-up \; send-keys -X middle-line
