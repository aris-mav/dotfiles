# Remap prefix
unbind-key C-b
set-option -g prefix C-a
bind-key C-a send-prefix
bind -n M-z resize-pane -Z

bind h split-window -h
bind v split-window -v

bind n run-shell \
         "~/.config/tmux/scripts/new_win_split.sh"

# External programs

bind -n M-m run-shell \
         "~/.config/tmux/scripts/open_window.sh music rmpc "
bind -n M-b run-shell \
         "~/.config/tmux/scripts/open_window.sh bottom btm "
bind -n M-= run-shell \
         "~/.config/tmux/scripts/open_window.sh notes '~/.config/scripts/nt.sh -s'"
bind -n M-t run-shell \
         "~/.config/tmux/scripts/open_window.sh TODO '~/.config/scripts/nt.sh TODO.txt'"

bind C-f display-popup -d "#{pane_current_path}" -E "fish"
bind C-t display-popup -B -E "ttyper -w 40"
