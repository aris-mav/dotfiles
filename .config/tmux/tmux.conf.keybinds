# unused and annoying
unbind-key Space

# Remap prefix
unbind-key C-b
set-option -g prefix C-a
bind-key C-a send-prefix

# Split on current dir
bind % split-window -h -c "#{pane_current_path}"
bind \" split-window -v -c "#{pane_current_path}"

# Fullscreen pane
bind -n M-z resize-pane -Z ""
 
bind e run-shell "~/.config/tmux/scripts/new_win_split.sh"

bind -n M-m run-shell \
         "~/.config/tmux/scripts/open_window.sh music rmpc "
bind -n M-b run-shell \
         "~/.config/tmux/scripts/open_window.sh bottom btm "
bind -n M-n run-shell \
         "~/.config/tmux/scripts/open_window.sh notes \
         '~/.config/scripts/nt.sh -s'"
bind -n M-t run-shell \
         "~/.config/tmux/scripts/open_window.sh TODO \
         '~/.config/scripts/nt.sh TODO'"

# Popups
bind C-f display-popup -d "#{pane_current_path}" \
         -S fg=green -b rounded -h 75% -w 75% \
         -E "fish"
bind C-n display-popup -d "#{pane_current_path}" \
         -S fg=green -b rounded -h 90% -w 90% \
         -E "fish -c nmtui"
bind C-b display-popup -d "#{pane_current_path}" \
         -b none -h 80% -w 80% \
         -E "fish -c bluetui"
bind C-t display-popup -B -E "ttyper -w 35"

# Kill pane without confirmation prompt
bind-key X kill-pane
