# Remap prefix
unbind-key C-b
set-option -g prefix C-a
bind-key C-a send-prefix
bind -n M-z resize-pane -Z

bind h split-window -h
bind v split-window -v

bind n run-shell ' \
         tmux new-window; \
         width=$(tmux display -p "#{window_width}"); \
         if [ "$width" -gt 150 ]; then \
         tmux split-window -h; \
         tmux resize-pane -x $((width / 2 + 25)); \
         elif [ "$width" -gt 120 ]; then \
         tmux split-window -h; \
         tmux resize-pane -x $((width * 66 / 100)); \
         fi'


# External programs

bind -n M-m run-shell "tmux new-window -n 'music' 'rmpc'"
bind -n M-b run-shell "tmux new-window -n 'bottom' 'btm'"

bind -n M-t run-shell "tmux split-window 'nt -t'"
bind -n M-+ run-shell "tmux split-window 'nt -n'"
bind -n M-= run-shell "tmux new-window -n 'notes' 'nt -s'"
