# Set the pane border color
set-option -g pane-border-style 'fg=black'
set-option -g pane-active-border-style 'fg=black'

# Status bar
set -g status-style 'fg=green,bg=terminal'
set -ag status-style "#{?client_prefix, fg=yellow,bg=terminal}"

set -g message-style 'bg=terminal,fg=yellow'
set -g message-command-style 'bg=terminal,fg=yellow'

set -g status-left ''
set -g status-right '[#S][#(whoami)@#H]'
set -g window-status-format '#I-#W'
set -g window-status-current-format '[#I-#W]'

# set -g prompt-cursor-colour 'terminal'
