[user]
    name = aris-mav
    email = aris.mav@protonmail.com

[core]
    pager = delta
	editor = nvim

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true  # use n and N to move between diff sections
    line-numbers = true
	syntax-theme = none

[merge]
    conflictstyle = zdiff3
	tool = nvimdiff
[pull]
	rebase = true
[init]
	defaultBranch = main
[diff]
	tool = nvimdiff
[difftool]
	prompt = false
[mergetool]
	prompt = false
